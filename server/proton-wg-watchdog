#!/bin/bash
# Self-healing watchdog for the Proton WireGuard tunnel (wg-quick@proton0).
#
# Runs as root via proton-wg-watchdog.timer. If wg-quick@proton0 is active and
# the newest peer handshake is older than STALE_SECONDS (180s), or has never
# completed (0) after the unit has been active for more than STALE_SECONDS,
# logs via logger and restarts wg-quick@proton0.
#
# Rate-limited to at most one restart per MIN_RESTART_INTERVAL (300s) using a
# state file under STATE_DIR (/run/proton-wg-watchdog). WireGuard keys are
# never printed or logged. Does nothing when the unit is inactive.
set -euo pipefail

WG_IFACE="${WG_IFACE:-proton0}"
WG_UNIT="${WG_UNIT:-wg-quick@${WG_IFACE}}"
STALE_SECONDS="${STALE_SECONDS:-180}"
MIN_RESTART_INTERVAL="${MIN_RESTART_INTERVAL:-300}"
STATE_DIR="${STATE_DIR:-/run/proton-wg-watchdog}"
STATE_FILE="${STATE_DIR}/last-restart"
WG_BIN="${WG_BIN:-wg}"
SYSTEMCTL_BIN="${SYSTEMCTL_BIN:-systemctl}"
LOGGER_BIN="${LOGGER_BIN:-logger}"
LOG_TAG="proton-wg-watchdog"

log() {
  "$LOGGER_BIN" -t "$LOG_TAG" -- "$*"
}

now_epoch() {
  if [ -n "${NOW_EPOCH:-}" ]; then
    printf '%s\n' "$NOW_EPOCH"
  else
    date +%s
  fi
}

unit_active_since_epoch() {
  local raw parsed
  raw="$("$SYSTEMCTL_BIN" show --timestamp=unix -p ActiveEnterTimestamp --value "$WG_UNIT" 2>/dev/null || true)"
  raw="${raw#"${raw%%[![:space:]]*}"}"
  raw="${raw%"${raw##*[![:space:]]}"}"
  [ -n "$raw" ] || return 1

  if [[ "$raw" =~ ^@([0-9]+)$ ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
    return 0
  fi
  if [[ "$raw" =~ ^[0-9]+$ ]]; then
    printf '%s\n' "$raw"
    return 0
  fi
  if parsed="$(date -d "$raw" +%s 2>/dev/null)" && [[ "$parsed" =~ ^[0-9]+$ ]]; then
    printf '%s\n' "$parsed"
    return 0
  fi
  return 1
}

# Do nothing if the unit is inactive (the user may have turned the VPN off).
if ! "$SYSTEMCTL_BIN" is-active --quiet "$WG_UNIT"; then
  exit 0
fi

# Query peer handshakes. Never print or log the output (column 1 is a peer key).
if ! hs_output="$("$WG_BIN" show "$WG_IFACE" latest-handshakes 2>/dev/null)"; then
  log "${WG_IFACE}: failed to query latest-handshakes while ${WG_UNIT} is active; skipping"
  exit 1
fi

newest_hs=""
while IFS=$' \t' read -r _peer ts _rest; do
  [ -n "${ts:-}" ] || continue
  if [[ "$ts" =~ ^[0-9]+$ ]]; then
    if [ -z "$newest_hs" ] || [ "$ts" -gt "$newest_hs" ]; then
      newest_hs="$ts"
    fi
  fi
done <<< "$hs_output"

# No peers reported: nothing to monitor.
if [ -z "$newest_hs" ]; then
  exit 0
fi

now="$(now_epoch)"
reason=""

if [ "$newest_hs" -gt 0 ]; then
  age=$(( now - newest_hs ))
  if [ "$age" -le "$STALE_SECONDS" ]; then
    exit 0
  fi
  reason="latest handshake ${age}s ago (threshold ${STALE_SECONDS}s)"
else
  # 0 = never handshaked; only restart if the unit has been active > STALE_SECONDS.
  if ! active_since="$(unit_active_since_epoch)"; then
    exit 0
  fi
  if [ "$active_since" -le 0 ]; then
    exit 0
  fi
  active_age=$(( now - active_since ))
  if [ "$active_age" -le "$STALE_SECONDS" ]; then
    exit 0
  fi
  reason="no handshake after ${active_age}s active (threshold ${STALE_SECONDS}s)"
fi

# Rate-limit: never restart more than once per MIN_RESTART_INTERVAL seconds.
if [ -r "$STATE_FILE" ]; then
  last_restart="$(head -n 1 "$STATE_FILE" 2>/dev/null || true)"
  if [[ "$last_restart" =~ ^[0-9]+$ ]]; then
    since_last=$(( now - last_restart ))
    if [ "$since_last" -ge 0 ] && [ "$since_last" -lt "$MIN_RESTART_INTERVAL" ]; then
      log "${WG_IFACE}: ${reason}, rate-limited (${since_last}s since last restart; min ${MIN_RESTART_INTERVAL}s)"
      exit 0
    fi
  fi
fi

# Record the restart attempt timestamp atomically before restarting so even a
# failing restart obeys the 5-minute cooldown.
mkdir -p "$STATE_DIR"
tmp_state="$(mktemp "${STATE_DIR}/.last-restart.XXXXXX")"
trap 'rm -f "${tmp_state:-}"' EXIT
printf '%s\n' "$now" > "$tmp_state"
mv -f "$tmp_state" "$STATE_FILE"
trap - EXIT

log "${WG_IFACE}: ${reason}; restarting ${WG_UNIT}"
if ! "$SYSTEMCTL_BIN" restart "$WG_UNIT"; then
  log "${WG_IFACE}: failed to restart ${WG_UNIT}"
  exit 1
fi
